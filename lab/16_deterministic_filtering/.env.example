# =============================================================================
# Lab 16 - deterministic filtering of sensitive data for AI retrieval
# Copy to .env and fill OPENAI_API_KEY. The real .env is gitignored.
# Only the agent's chat call goes to OpenAI; embeddings are computed locally.
# =============================================================================

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-6-luna

# Local dense embedding model (1024 dims); sparse is a local SPLADE model
EMBED_MODEL=voyageai/voyage-4-nano
# Models are cached after the first download; offline mode skips the update check
# on every load (set to 0 for the very first run, when the models must download).
HF_HUB_OFFLINE=1

# --- Bank database: lab16_pg18 ----------------------------------------------
BANK_HOST=localhost
BANK_PORT=5437
BANK_DB=bank
BANK_ADMIN_USER=lab_admin
BANK_ADMIN_PASSWORD=dbi2026!
GATEWAY_USER=gateway
GATEWAY_PASSWORD=dbi2026!
AGENT_USER=app_agent
AGENT_PASSWORD=dbi2026!

# --- Vault database: lab16_vault (separate server, holds key + mapping) -----
VAULT_HOST=localhost
VAULT_PORT=5438
VAULT_DB=vault
VAULT_ADMIN_USER=vault_admin
VAULT_ADMIN_PASSWORD=vault2026!
TOKENIZER_USER=tokenizer
TOKENIZER_PASSWORD=vault2026!
REIDENTIFIER_USER=reidentifier
REIDENTIFIER_PASSWORD=vault2026!
